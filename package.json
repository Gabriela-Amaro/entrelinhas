{
  "name": "entrelinhas",
  "version": "1.2.0",
  "private": true,
  "description": "Leitor de Markdown com abas, Mermaid e sessões persistentes",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "postinstall": "install-electron",
    "desktop": "node scripts/dev-desktop.mjs",
    "start": "npm run build && node scripts/start-desktop.mjs",
    "build": "tsc -b && vite build && node scripts/third-party-notices.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dist": "npm run dist:linux",
    "install:desktop": "node scripts/install-linux.mjs",
    "pack": "npm run build && electron-builder --dir",
    "test:desktop": "npm run build && node scripts/test-desktop.mjs",
    "dist:linux": "npm run build && electron-builder --linux --publish never && node scripts/bundle-linux.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "checksums": "node scripts/checksums.mjs"
  },
  "build": {
    "appId": "com.entrelinhas.reader",
    "productName": "Entrelinhas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "public/icon.png",
      "LICENSE"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office",
      "icon": "public/icon.png",
      "executableName": "entrelinhas",
      "syncDesktopName": true,
      "maintainer": "Gabriela Amaro dos Santos <171707971+Gabriela-Amaro@users.noreply.github.com>",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown"
      ],
      "desktop": {
        "entry": {
          "Name": "Entrelinhas",
          "Comment": "Leitor e editor de Markdown com abas e Mermaid",
          "Keywords": "Markdown;MD;Mermaid;leitor;editor;notas;"
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "artifactName": "Entrelinhas-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png",
      "artifactName": "Entrelinhas-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Entrelinhas",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon.png",
      "artifactName": "Entrelinhas-${version}-macos-${arch}.${ext}",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "Entrelinhas ${version}"
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "idb-keyval": "^6.3.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.58.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "Gabriela Amaro dos Santos",
    "url": "https://github.com/Gabriela-Amaro"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabriela-Amaro/entrelinhas.git"
  },
  "homepage": "https://github.com/Gabriela-Amaro/entrelinhas",
  "bugs": {
    "url": "https://github.com/Gabriela-Amaro/entrelinhas/issues"
  },
  "desktopName": "com.entrelinhas.reader.desktop",
  "engines": {
    "node": ">=22.12.0"
  }
}
